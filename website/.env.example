# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real secrets.
# Every variable here is server-only. Never prefix any of them with NEXT_PUBLIC_.

# --- Database (MongoDB) ---

# Required. MongoDB connection string. The app throws on startup without it.
# Must point at a replica set, because orders, solutions, claims and role changes
# use transactions. Atlas is a replica set by default. For a local Docker
# cluster, include ?replicaSet=<name> in the URI.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0

# Optional. Database name. Defaults to "fitvisualizer" if unset.
MONGODB_DB=fitvisualizer

# --- Authentication ---

# Required. Secret used to sign login session tokens (JWT, stored in an
# HTTP-only cookie). Login fails without it. Use a long random value,
# e.g. `openssl rand -hex 32`. Changing it signs every user out.
JWT_SECRET=

# --- Machine-to-machine API keys ---

# Required to accept external orders. Sent by the external order system as the
# `x-api-key` header on POST /api/orders/intake. If unset, every intake request
# is rejected with 401.
ORDER_INTAKE_API_KEY=

# Optional. Key for pushing solutions in from outside: callers send it as the
# `x-api-key` header on POST /api/solutions. If unset, that route rejects every
# request with 401. The default flow (portal calls the solver and reads the
# reply directly) does not use it.
# Must be different from SOLVER_AUTH_TOKEN.
SOLVER_API_KEY=

# --- Solver connection ---

# Full solver endpoint. Override with the deployed service URL, including /solve.
# Must be HTTPS unless it points at localhost.
SOLVER_URL=http://127.0.0.1:8080/solve

# Required server-only credential, identical to SOLVER_AUTH_TOKEN in the Rust
# solver environment. Generate 32 random bytes (e.g. 64 hex characters).
# Never prefix this with NEXT_PUBLIC_ or reuse SOLVER_API_KEY (callback auth).
SOLVER_AUTH_TOKEN=
