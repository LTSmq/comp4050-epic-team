# Full solver endpoint. Override with the deployed service URL, including /solve.
SOLVER_URL=http://127.0.0.1:8080/solve

# Required server-only credential, identical to SOLVER_AUTH_TOKEN in the Rust
# solver environment. Generate 32 random bytes (e.g. 64 hex characters).
# Never prefix this with NEXT_PUBLIC_ or reuse SOLVER_API_KEY (callback auth).
SOLVER_AUTH_TOKEN=
