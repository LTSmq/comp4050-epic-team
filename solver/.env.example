# Required: generate 32 random bytes (e.g. 64 hex characters) and configure the
# same value on the website server. No default token or authentication bypass.
SOLVER_AUTH_TOKEN=

# Loopback is the default. For Cloud Run/containers set 0.0.0.0:<container-port>.
LISTEN_ADDR=127.0.0.1:8080

# Optional legacy solution delivery; leave unset for the website's direct flow.
# VISUALIZER_URL=http://127.0.0.1:3001/solutions
